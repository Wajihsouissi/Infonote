/* ---------- 7. Special Primary Action Button ----------
   THE ONE SANCTIONED EXCEPTION to the no-glow / no-idle-motion rules.

   This is the canvas FAB — the single hero action in the app. It deliberately
   keeps a warm accent glow, a white rim-light, and the slow `orbBreathe` idle
   animation, all of which §3.11 / §9 / §11 otherwise ban. That is intentional,
   confirmed 2026-07-24; do NOT "fix" it in a consistency pass, and do not copy
   this treatment onto any other control. Everything else in the app stays flat.

   All of its colour still comes from tokens (--accent-rgb / --on-accent), so it
   remains theme-aware in Ink and Paper.                                        */
.special-primary-btn {
  --orb-rim: 255, 224, 210;

  --orb-glow-rest-a: rgba(var(--accent-rgb), 0.38);
  --orb-glow-rest-b: rgba(var(--accent-rgb), 0.22);
  --orb-glow-peak-a: rgba(var(--accent-rgb), 0.55);
  --orb-glow-peak-b: rgba(var(--accent-rgb), 0.42);
  --orb-glow-hover-a: rgba(var(--accent-rgb), 0.55);
  --orb-glow-hover-b: rgba(var(--accent-rgb), 0.45);
  --orb-ground: transparent;

  position: relative;
  width: 48px;
  height: 48px;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  outline: none;
  cursor: pointer;
  color: var(--on-accent);
  background: radial-gradient(125% 125% at 32% 24%,
      var(--accent-ink) 0%,
      var(--accent) 46%,
      var(--accent-deep) 100%);
  box-shadow:
    0 4px 14px var(--orb-glow-rest-a),
    0 0 20px var(--orb-glow-rest-b),
    0 2px 6px var(--orb-ground);
  z-index: 10;
  animation: orbBreathe 4.5s ease-in-out infinite;
  transition:
    transform 0.3s cubic-bezier(0.34, 1.4, 0.5, 1),
    box-shadow 0.3s ease;
}

:global([data-theme='light']) .special-primary-btn,
[data-theme='light'] .special-primary-btn {
  --orb-glow-rest-a: rgba(var(--accent-rgb), 0.20);
  --orb-glow-rest-b: rgba(var(--accent-rgb), 0.10);
  --orb-glow-peak-a: rgba(var(--accent-rgb), 0.30);
  --orb-glow-peak-b: rgba(var(--accent-rgb), 0.16);
  --orb-glow-hover-a: rgba(var(--accent-rgb), 0.34);
  --orb-glow-hover-b: rgba(var(--accent-rgb), 0.20);
  --orb-ground: rgba(38, 28, 14, 0.22);
}

.special-primary-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  padding: 1.5px;
  background: linear-gradient(168deg,
      rgba(var(--orb-rim), 0.95) 0%,
      rgba(var(--orb-rim), 0.4) 34%,
      rgba(var(--orb-rim), 0.08) 58%,
      transparent 76%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  mask-composite: exclude;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.special-primary-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(from 0deg,
      transparent 0deg,
      rgba(var(--orb-rim), 0.5) 26deg,
      transparent 70deg);
  opacity: 0;
  pointer-events: none;
  animation: orbSweep 4s linear infinite;
  transition: opacity 0.35s ease;
}

.special-primary-btn:hover {
  animation: none;
  transform: translateY(-3px) scale(1.07);
  box-shadow:
    0 10px 26px var(--orb-glow-hover-a),
    0 0 34px var(--orb-glow-hover-b),
    0 4px 10px var(--orb-ground);
}

.special-primary-btn:hover::after {
  opacity: 0.8;
}

.special-primary-btn:active {
  transform: translateY(-1px) scale(0.94);
  transition-duration: 0.09s;
}

.special-primary-btn:focus-visible {
  box-shadow:
    0 0 0 3px var(--bg-base),
    0 0 0 5px var(--accent),
    0 8px 24px rgba(var(--accent-rgb), 0.5);
}

.special-primary-btn svg {
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 1px 2px rgba(var(--accent-rgb), 0.55));
  transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.5, 1);
}

.special-primary-btn:hover svg {
  transform: rotate(90deg) scale(1.06);
}

@keyframes orbBreathe {

  0%,
  100% {
    box-shadow:
      0 4px 14px var(--orb-glow-rest-a),
      0 0 18px var(--orb-glow-rest-b),
      0 2px 6px var(--orb-ground);
  }

  50% {
    box-shadow:
      0 5px 18px var(--orb-glow-peak-a),
      0 0 30px var(--orb-glow-peak-b),
      0 3px 8px var(--orb-ground);
  }
}

@keyframes orbSweep {
  to {
    transform: rotate(1turn);
  }
}

@media (prefers-reduced-motion: reduce) {

  .special-primary-btn,
  .special-primary-btn::after {
    animation: none;
  }

  .special-primary-btn:hover {
    transform: none;
  }

  .special-primary-btn:hover svg {
    transform: none;
  }
}

/* ============================================================
   Editor Inline Links (Text Mode)
   ============================================================ */

.editor-inline-link {
