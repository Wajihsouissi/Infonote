@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================================
   chnk it — GLOBAL DESIGN SYSTEM · "Paper & Ink"
   ------------------------------------------------------------
   The single source of truth for every color, font, radius,
   shadow and motion value in the app. Components must consume
   these tokens (var(--…)) — never hardcode brand colors.

   Art direction: flat editorial surfaces, hairline rules,
   electric blue accent, cool cyan secondary. Dark theme is
   deep blue graphite ("Ink"), light theme is tactile blue-white ("Paper").
   No glassmorphism, no cheap glows.

   Sections:
     1. Static tokens (typography, radius, motion)
     2. Ink theme (dark — default)
     3. Paper theme (light)
     4. Legacy aliases (old variable names → new tokens)
     5. Canvas & UI Component layer
     6. Corner shape — Apple-style continuous curvature
     7. Accent palette — ten user-assignable hues, three shades each
   ============================================================ */

/* ---------- 1. static tokens ---------- */

:root {
  /* type families */
  --font-sans: 'Outfit', sans-serif;
  --font-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia,
    'Times New Roman', serif;
  --font-mono: ui-monospace, 'Cascadia Mono', 'SF Mono', Menlo, Consolas,
    'Liberation Mono', monospace;

  /* radius scale */
  --radius-xs: 4px;
  --radius-sm: 7px;
  --radius-md: 9px;
  --radius-lg: 12px;
  --radius-xl: 14px;
  --radius-pill: 999px;

  /* squircle radius scale — "Paper & Ink v2". A six-step scale that
     pairs with the global superellipse corner-shape:
       xs        4px → chips, ticks, small insets
       control   8px → buttons, inputs, menu items
       md       12px → block nodes, secondary cards
       surface  16px → nodes, cards, menus, popovers
       lg       24px → large cards, sheets
       panel    32px → modals, large floating panels */
  --r-xs: 4px;
  --r-control: 8px;
  --r-md: 12px;
  --r-surface: 16px;
  --r-lg: 24px;
  --r-panel: 32px;

  /* corner shape — Apple-style continuous curvature. superellipse(2)
     is the canonical "squircle". */
  --corner-smooth: superellipse(2);

  /* motion */
  --transition-fast: 0.15s ease;
  --transition-smooth: 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  --ease-rise: cubic-bezier(0.22, 0.9, 0.3, 1);

  /* The surface transparent media is composited onto.
     Deliberately NOT theme-aware, and deliberately mid-luminance. Uploaded art
     with an alpha channel arrives at an unknown polarity — black line work
     drawn for a white page, white logos drawn for a dark one — and either of
     our own grounds erases one of them: on ink the black art disappears, on
     paper the white art does. A warm mid grey is the only ground both survive,
     and holding it fixed across themes means a logo looks the same wherever it
     is dropped instead of inverting when the theme is toggled.
     Only ever seen through alpha; opaque media covers it completely. */
  --media-plate: #71849a;
}

/* ---------- 2. Ink (dark — default) ---------- */

:root,
:root[data-theme='dark'] {
  color-scheme: dark;

  /* surfaces: layered depth hierarchy — warm graphite "Ink".
     Every step carries the same blue undertone so the darks read calm and
     intentional rather than neutral black. The tight spread lets hairlines
     and elevation do the separating. */
  --bg-inset: #08111f;
  /* canvas ground / inset wells (deepest ink) */
  --bg-base: #0c1728;
  /* primary container ground */
  --bg-rail: #122238;
  /* structural rails, sidebar, resting nodes */
  --bg-card: #172b43;
  /* note content, expanded cards */
  --bg-raised: #1d3550;
  /* modals, popovers, floating menus, toolbars */

  /* hairlines & washes */
  --line: rgba(211, 229, 247, 0.10);
  --line-strong: rgba(211, 229, 247, 0.18);
  --line-heavy: rgba(211, 229, 247, 0.28);
  --hover-wash: rgba(113, 177, 228, 0.08);
  --active-wash: rgba(80, 165, 232, 0.16);
  --dot: rgba(170, 207, 239, 0.15);

  /* text */
  --text-main: #e8f2fc;
  --text-soft: #acc2d8;
  --text-faint: #7890a8;

  /* accent — electric persimmon */
  --accent: #42a9ff;
  --accent-hover: #63b9ff;
  --accent-ink: #8dceff;
  /* accent for text/icons/borders on dark */
  --accent-deep: #1687d4;
  --accent-dim: rgba(66, 169, 255, 0.16);
  --accent-wash: rgba(66, 169, 255, 0.22);
  --on-accent: #061321;
  --on-accent-rgb: 6, 19, 33;
  --accent-rgb: 66, 169, 255;

  /* secondary — warm golden amber */
  --secondary: #48d1c4;
  --secondary-ink: #8ce8de;
  --secondary-dim: rgba(72, 209, 196, 0.15);
  --secondary-rgb: 72, 209, 196;

  /* feedback */
  --ok: #65d487;
  --warn: #f3be65;
  --danger: #ff6b5b;
  --ok-rgb: 101, 212, 135;
  --warn-rgb: 243, 190, 101;
  --danger-rgb: 255, 107, 91;

  /* tertiary — warm-adapted functional hues (tags, categories, syntax).
     Muted and never cosmic; the -ink variants read on the dark ground. */
  --t-blue: #76bdf0;
  --t-pink: #df9bc4;
  --t-yellow: #e4c873;
  --t-purple: #b9a6ee;
  --t-green: #8ed6ad;
  --t-red: #f08d9b;

  /* accent palette — ten hues the user assigns to things they own (board
     columns today, tags and categories next). See §7 for the full rationale and
     for the wash/edge shades derived from these.

     A tenth of the wheel apart, all held at one lightness and one chroma so no
     hue shouts over another in a row of ten. Warm-adapted like everything else
     here: even the greens and blues carry a little red, so a column never reads
     as a cold sticker dropped onto a warm page. */
  --a-rose: #e18da6;
  --a-amber: #e6aa72;
  --a-citrine: #dfc975;
  --a-olive: #aebe7c;
  --a-jade: #7fcda4;
  --a-teal: #62d0c4;
  --a-azure: #6bbaf0;
  --a-indigo: #96a8eb;
  --a-violet: #b69be7;
  --a-magenta: #d597cb;

  /* elevation — neutral contact shadow + ambient depth */
  --elev-1: 0 1px 3px rgba(0, 0, 0, 0.35), 0 1px 2px rgba(0, 0, 0, 0.25);
  --elev-2: 0 6px 16px rgba(0, 0, 0, 0.40), 0 12px 28px rgba(0, 0, 0, 0.35);
  --elev-3: 0 20px 48px rgba(0, 0, 0, 0.50), 0 32px 72px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 20px 50px rgba(0, 8, 20, 0.56);
  --shadow-sm: 0 4px 14px rgba(0, 8, 20, 0.36);
  --focus-ring: 0 0 0 3px var(--accent-dim);
}

/* ---------- 3. Paper (light) ---------- */

:root[data-theme='light'] {
  color-scheme: light;

  /* surfaces: cool tactile paper hierarchy */
  --bg-inset: #eef4fa;
  /* desk inset ground (soft blue-white) */
  --bg-base: #f5f8fc;
  /* quiet blue-tinted gray */
  --bg-rail: #ffffff;
  /* sidebar, rails, resting nodes (white) */
  --bg-card: #ffffff;
  /* expanded card & editor paper surface */
  --bg-raised: #ffffff;
  /* floating popovers & modals */

  /* hairlines & washes */
  --line: rgba(20, 55, 91, 0.10);
  --line-strong: rgba(20, 55, 91, 0.18);
  --line-heavy: rgba(20, 55, 91, 0.30);
  --hover-wash: rgba(45, 126, 192, 0.06);
  --active-wash: rgba(45, 126, 192, 0.12);
  --dot: rgba(30, 82, 128, 0.18);

  /* text */
  --text-main: #10243a;
  --text-soft: #47617a;
  --text-faint: #71879c;

  /* accent — deep editorial persimmon */
  --accent: #1479c9;
  --accent-hover: #0d66ae;
  --accent-ink: #146caf;
  --accent-deep: #0b4f87;
  --accent-dim: rgba(20, 121, 201, 0.12);
  --accent-wash: rgba(20, 121, 201, 0.16);
  --on-accent: #f7fbff;
  --on-accent-rgb: 247, 251, 255;
  --accent-rgb: 20, 121, 201;

  /* secondary — warm golden bronze */
  --secondary: #168c86;
  --secondary-ink: #126e69;
  --secondary-dim: rgba(22, 140, 134, 0.12);
  --secondary-rgb: 22, 140, 134;

  /* feedback */
  --ok: #277a3f;
  --warn: #9e6e10;
  --danger: #b83b2a;
  --ok-rgb: 39, 122, 63;
  --warn-rgb: 158, 110, 16;
  --danger-rgb: 184, 59, 42;

  /* tertiary — warm-adapted functional hues (deepened for paper contrast) */
  --t-blue: #216a98;
  --t-pink: #9a4f78;
  --t-yellow: #866b16;
  --t-purple: #68518e;
  --t-green: #3c7656;
  --t-red: #a84d61;

  /* accent palette — the same ten hues, deepened for paper (see §7).
     Only these ten values change between themes; every shade derived from them
     follows automatically, so a column keeps its identity across Ink and Paper
     instead of needing a second set of rules. */
  --a-rose: #a34f69;
  --a-amber: #9a6528;
  --a-citrine: #806718;
  --a-olive: #5e712c;
  --a-jade: #3b7956;
  --a-teal: #21756f;
  --a-azure: #286d99;
  --a-indigo: #4e5fa0;
  --a-violet: #70579a;
  --a-magenta: #8d4f7e;

  /* elevation — cool blue-grey shadows so paper keeps its atmosphere */
  --elev-1: 0 1px 3px rgba(18, 52, 86, 0.08), 0 1px 2px rgba(18, 52, 86, 0.05);
  --elev-2: 0 6px 16px rgba(18, 52, 86, 0.11), 0 12px 28px rgba(18, 52, 86, 0.08);
  --elev-3: 0 20px 48px rgba(18, 52, 86, 0.16), 0 32px 72px rgba(18, 52, 86, 0.13);
  --shadow-lg: 0 20px 50px rgba(36, 26, 12, 0.15);
  --shadow-sm: 0 4px 14px rgba(36, 26, 12, 0.08);
  --focus-ring: 0 0 0 3px var(--accent-dim);
}

/* ---------- 4. legacy aliases ---------- */

:root,
:root[data-theme='dark'] {
  --color-bg-base: var(--bg-base);
  --color-bg-surface: var(--bg-rail);
  --color-bg-card: var(--bg-card);

  --color-primary: var(--accent);
  --color-primary-glow: var(--accent-dim);
  --color-secondary: var(--secondary);

  --color-text-main: var(--text-main);
  --color-text-muted: var(--text-soft);
  --color-border: var(--line);

  --border: var(--line);
  --border-hover: var(--line-strong);
  --surface-elevated: var(--bg-raised);

  --glass-bg: var(--bg-raised);
  --glass-bg-hover: rgba(36, 34, 42, 0.98);
  --glass-border: var(--line-strong);
  --glass-shadow: var(--elev-2);
  --backdrop-blur: 12px;

  --handle-glass-bg: rgba(240, 236, 227, 0.1);
  --handle-glass-border: rgba(240, 236, 227, 0.2);
  --handle-glass-shadow: none;

  --ui-hover: var(--hover-wash);
  --ui-active: var(--active-wash);
  --ui-border-low: rgba(240, 236, 227, 0.05);

  --modal-bg: var(--bg-raised);
  --note-bg: var(--bg-card);

  --xy-background-color-default: var(--bg-inset);
  --rf-controls-bg: var(--bg-raised);
  --rf-controls-border: var(--line-strong);
  --rf-controls-text: var(--text-main);
  --rf-controls-hover-bg: var(--hover-wash);
}

:root[data-theme='light'] {
  --color-bg-base: var(--bg-base);
  --color-bg-surface: var(--bg-rail);
  --color-bg-card: var(--bg-card);

  --color-primary: var(--accent);
  --color-primary-glow: var(--accent-dim);
  --color-secondary: var(--secondary);

  --color-text-main: var(--text-main);
  --color-text-muted: var(--text-soft);
  --color-border: var(--line);

  --border: var(--line);
  --border-hover: var(--line-strong);
  --surface-elevated: var(--bg-raised);

  --glass-bg: var(--bg-raised);
  --glass-bg-hover: rgba(255, 255, 255, 0.99);
  --glass-border: var(--line);
  --glass-shadow: var(--elev-2);
  --backdrop-blur: 12px;

  --handle-glass-bg: rgba(28, 24, 16, 0.1);
  --handle-glass-border: rgba(28, 24, 16, 0.2);
  --handle-glass-shadow: none;

  --ui-hover: var(--hover-wash);
  --ui-active: var(--active-wash);
  --ui-border-low: rgba(28, 24, 16, 0.06);

  --modal-bg: var(--bg-raised);
  --note-bg: var(--bg-card);

  --xy-background-color-default: var(--bg-inset);
  --rf-controls-bg: var(--bg-raised);
  --rf-controls-border: var(--line-strong);
  --rf-controls-text: var(--text-main);
  --rf-controls-hover-bg: var(--hover-wash);
}

/* ---------- 5. Canvas & UI Component layer ---------- */
:root {
  /* canvas desk ground */
  --canvas-bg: var(--bg-inset);
  --canvas-dot: var(--dot);

  /* app shell — the chrome the canvas is inset into. The top bar carries every
     control that used to float over the canvas as its own pill; the desk then
     sits in a frame with an even reveal on left/right/bottom, so the
     canvas reads as a sheet laid inside the app rather than under it. */
  --shell-bg: var(--bg-rail);
  --shell-inset: 8px;
  --shell-radius: 40px;
  --topbar-h: 56px;
  --topbar-pad-x: 12px;
  --topbar-gap: 8px;

  /* Side panels get the same treatment as the canvas: the panel itself is
     chrome, continuous with the shell around it, and its content sits in an
     inset surface with the frame's radius. The whole app then reads as one
     ground with rounded content islands floating in it. */
  --panel-bg: var(--shell-bg);
  --panel-body-bg: var(--bg-base);
  --panel-radius: var(--shell-radius);
  --panel-inset: var(--shell-inset);

  /* node surfaces */
  /* --bg-card sits one step above --bg-rail in Ink, which is what gives a node
     a readable silhouette against the near-black desk; in Paper both are #fff
     and the ring does the work. */
  --node-bg: var(--bg-rail);
  --node-radius: var(--r-surface);
  --node-pad: 12px;
  --node-spine-w: 3px;
  /* rest / hover / selected read as a 1 → 1.5 → 2px ladder, with the colour
     change reserved for selection. */
  --node-ring: 0 0 0 1px var(--line-heavy);
  --node-ring-hover: 0 0 0 1.5px var(--line-heavy);
  --node-ring-selected: 0 0 0 2px var(--accent);
  --node-ring-drag: 0 0 0 2px var(--accent);
  --node-shadow-rest: var(--elev-1);
  --node-shadow-hover: var(--elev-2);
  --node-shadow-drag: var(--elev-3);
  --node-title: var(--text-main);
  --node-subtle: var(--text-soft);
  --node-meta: var(--text-faint);
  --node-field-hover: var(--hover-wash);
  --node-field-active: var(--active-wash);

  /* connection handles */
  --handle-size: 14px;
  --handle-bg: var(--bg-raised);
  --handle-ring: 2px solid var(--accent);
  --handle-bg-active: var(--accent);
  --handle-halo: 0 0 0 4px var(--accent-dim);

  /* canvas edges */
  --edge: var(--line-strong);
  --edge-selected: var(--accent);
  --edge-w: 1.5px;
  --edge-w-selected: 2px;

  /* floating menus & popovers (context, slash, metadata) */
  --menu-bg: var(--bg-raised);
  --menu-border: var(--line-strong);
  --menu-radius: var(--r-surface);
  --menu-shadow: var(--elev-2);
  --menu-pad: 6px;
  --menu-item-radius: var(--r-control);
  --menu-item-hover: var(--hover-wash);
  --menu-item-active: var(--active-wash);
  --menu-divider: var(--line);
  --menu-chevron: var(--text-faint);

  /* floating pill toolbars (edit bar, multi-select, edge editing) */
  --toolbar-bg: var(--bg-rail);
  --toolbar-border: var(--line-strong);
  --toolbar-radius: var(--radius-pill);
  --toolbar-shadow: var(--elev-2);
  --toolbar-btn-hover: var(--hover-wash);
  --toolbar-btn-active: var(--active-wash);

  /* buttons */
  --btn-radius: var(--r-control);
  --btn-pad: 9px 16px;
  --btn-primary-bg: var(--accent);
  --btn-primary-bg-hover: var(--accent-hover);
  --btn-primary-fg: var(--on-accent);
  --btn-secondary-bg: var(--bg-raised);
  --btn-secondary-border: var(--line-strong);
  --btn-secondary-fg: var(--text-main);
  --btn-secondary-hover: var(--hover-wash);
  --btn-ghost-fg: var(--text-soft);
  --btn-ghost-hover: var(--hover-wash);
  --btn-danger-bg: var(--danger);
  --btn-danger-fg: var(--on-accent);

  /* form controls & chips */
  --input-bg: var(--bg-inset);
  --input-border: var(--line);
  --input-border-focus: var(--accent);
  --input-radius: var(--r-control);
  --input-pad: 9px 12px;
  --chip-radius: var(--radius-pill);
  --chip-bg: var(--accent-dim);
  --chip-fg: var(--accent-ink);

  /* ---- content blocks ----
     The atomic editor blocks (text, headings, lists, todo, quote, code,
     callout, toggle, table, media, link) — rendered both standalone on the
     canvas and stacked inside note cards. One dial for the whole block
     family: change it here, every block type follows. */

  /* standalone block NODES on the canvas — one uniform footprint so a column
     of mixed block types reads as an even stack. The node is the outer box;
     its inner .content fills it edge-to-edge, and the breathing space around
     the text lives on the inner gutter below (never on the outer box). */
  --block-node-w: 260px;
  --block-node-h: 56px;
  --block-node-gutter-x: 14px;
  --block-node-gutter-y: 8px;
  /* the visible inner box, once the gutter is removed — every block type's
     inner container resolves to this, so callout/quote/toggle match plain text */
  --block-node-inner-h: calc(var(--block-node-h) - 2 * var(--block-node-gutter-y));
  /* A block grows with its text up to --block-node-max, then wraps and grows
     downward instead. 432px is MIN_EXPANDED_SIZE (config/layout.ts) so a fully
     grown block lines up with an expanded note card. Dragging the resize
     handle can push it further, to --block-node-max-user. */
  --block-node-max: 432px;
  --block-node-max-user: 800px;

  /* rhythm & metrics */
  --block-gap: 6px;
  --block-pad-x: 8px;
  --block-pad-y: 2px;
  --block-min-h: 24px;
  /* One ladder at a ~1.26 ratio, chosen so every step lands on a whole pixel
     at the 16px root: 15 / 19 / 24 / 30. Fractional rem (0.95, 1.45, 1.85…)
     rasterised soft, which compounded at non-integer canvas zoom. */
  --block-font: 0.9375rem;
  --block-h3: 1.1875rem;
  --block-h2: 1.5rem;
  --block-h1: 1.875rem;
  --block-leading: 1.6;
  --block-leading-heading: 1.2;
  --block-inset: 12px;
  /* Marker column (bullet, number, checkbox, triangle, callout icon). Fixed
     width so every marker-bearing block lands its text on the same left edge
     — markers used to be intrinsically sized, which produced a different
     text inset for every block type. */
  --block-marker-gap: 8px;
  --block-marker-col: 24px;

  /* radii — small for inline text targets, md for boxed blocks */
  --block-radius: var(--r-control);
  --block-radius-lg: var(--r-md);
  /* Media is the exception, and takes the card's own corner rather than the
     boxed-block one. A picture is not a box of text: it is a card in its own
     right — the thing you pin to a board, drag between notes, and look at —
     so it is cut to the same silhouette as the cards it travels between.
     Every media surface reads from this one dial: image, video and file
     blocks, their placeholders and selection rings, and every tile on a
     gallery board. */
  --media-radius: var(--r-panel);

  /* structure & marks */
  --block-rail-w: 3px;
  --block-rail: var(--accent-ink);
  --block-marker: var(--text-faint);
  --block-handle: var(--text-faint);
  --block-handle-hover: var(--accent-ink);

  /* surfaces & states */
  --block-well: var(--bg-inset);
  --block-well-line: var(--line);
  --block-hover: var(--hover-wash);
  /* Softer than --accent-dim on purpose: with the ring removed (below) this
     wash is the whole selected-state, so it needs to read as "tinted" rather
     than "boxed" at a glance. */
  --block-selected: color-mix(in srgb, var(--accent) 9%, transparent);
  --block-drop-line: var(--accent);
  --block-media-ring: 0 0 0 2px var(--accent-ink);

  /* table block */
  --table-bg: var(--bg-card);
  --table-header-bg: var(--hover-wash);
  --table-border: var(--line);
  --table-border-strong: var(--line-strong);
  --table-row-hover: var(--hover-wash);
  --table-selected: var(--accent-dim);
  --table-cell-focus: var(--accent-dim);
  --table-cell-min-h: 38px;

  /* link / bookmark block */
  --link-bg: var(--accent-dim);
  --link-border: rgba(var(--accent-rgb), 0.22);
  --link-bg-hover: var(--accent-wash);
  --link-border-hover: var(--accent);
}

/* ---------- 7. Accent palette — shades ----------

   Ten hues (§2 for Ink, §3 for Paper), each in three shades:

     --a-<hue>         the colour itself — a dot, a heading, a hairline
     --a-<hue>-wash    a tint to lay a surface in
     --a-<hue>-edge    a tint for that surface's border

   Only the base is authored per theme; the two tints are mixed from it here,
   once, for both. That is deliberate — it means a hue can never drift out of
   family between light and dark, and re-tuning "how strong is a wash" is one
   number rather than sixty. Mixing toward `transparent` rather than toward a
   named background also lets a wash sit on whatever surface it lands on: a lane
   on the desk, a chip on a card, a row in a table.

   Alphas are low on purpose. These mark ownership — this column is mine, that
   tag is design — and a board of ten saturated columns is a toy. The colour
   should be the quietest thing that still answers "which one is this".         */

:root {
  --a-wash-mix: 12%;
  --a-edge-mix: 34%;

  --a-rose-wash: color-mix(in srgb, var(--a-rose) var(--a-wash-mix), transparent);
  --a-amber-wash: color-mix(in srgb, var(--a-amber) var(--a-wash-mix), transparent);
  --a-citrine-wash: color-mix(in srgb, var(--a-citrine) var(--a-wash-mix), transparent);
  --a-olive-wash: color-mix(in srgb, var(--a-olive) var(--a-wash-mix), transparent);
  --a-jade-wash: color-mix(in srgb, var(--a-jade) var(--a-wash-mix), transparent);
  --a-teal-wash: color-mix(in srgb, var(--a-teal) var(--a-wash-mix), transparent);
  --a-azure-wash: color-mix(in srgb, var(--a-azure) var(--a-wash-mix), transparent);
  --a-indigo-wash: color-mix(in srgb, var(--a-indigo) var(--a-wash-mix), transparent);
  --a-violet-wash: color-mix(in srgb, var(--a-violet) var(--a-wash-mix), transparent);
  --a-magenta-wash: color-mix(in srgb, var(--a-magenta) var(--a-wash-mix), transparent);

  --a-rose-edge: color-mix(in srgb, var(--a-rose) var(--a-edge-mix), transparent);
  --a-amber-edge: color-mix(in srgb, var(--a-amber) var(--a-edge-mix), transparent);
  --a-citrine-edge: color-mix(in srgb, var(--a-citrine) var(--a-edge-mix), transparent);
  --a-olive-edge: color-mix(in srgb, var(--a-olive) var(--a-edge-mix), transparent);
  --a-jade-edge: color-mix(in srgb, var(--a-jade) var(--a-edge-mix), transparent);
  --a-teal-edge: color-mix(in srgb, var(--a-teal) var(--a-edge-mix), transparent);
  --a-azure-edge: color-mix(in srgb, var(--a-azure) var(--a-edge-mix), transparent);
  --a-indigo-edge: color-mix(in srgb, var(--a-indigo) var(--a-edge-mix), transparent);
  --a-violet-edge: color-mix(in srgb, var(--a-violet) var(--a-edge-mix), transparent);
  --a-magenta-edge: color-mix(in srgb, var(--a-magenta) var(--a-edge-mix), transparent);
}

/* ---------- 5b. Icon button affordance ----------
   The one hover a plain icon-only control gets, app-wide — the same quiet
   wash as .menuBtn (the Center Peak button): a hover tint, full-strength
   text, a small scale. Before this, every close/action/panel icon button
   invented its own hover (dashed rings, lifts, hardcoded rgba washes that
   didn't survive a theme switch), so the same gesture read differently
   depending on which panel you were in.

   Carries no background of its own at rest, so it layers over whatever tile
   or chip the host surface already draws.

   Deliberately NOT applied to: buttons with a semantic hover colour (a
   delete/close button that reddens, an active-toggle button that goes
   accent-filled) — recolouring those on hover is the point, not a bug; the
   floating-toolbar family (BottomMenu, CanvasBoard, MultiSelectionToolbar,
   StorageControls) — those four already agree with each other on an
   accent-tinted lift and are a second deliberate pattern, not an
   inconsistency; and controls overlaid on photos/video (PDFViewer,
   MediaLightbox, FullscreenModal) — fixed white-on-black there is
   intentional since they sit over arbitrary media, not app chrome.        */
.icon-hover {
  cursor: pointer;
  transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
}

.icon-hover:hover {
  background: var(--hover-wash);
  color: var(--text-main);
  transform: scale(1.1);
}

.icon-hover:active {
  transform: scale(0.96);
}

.icon-hover:focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
}

@media (prefers-reduced-motion: reduce) {
  .icon-hover,
  .icon-hover:hover,
  .icon-hover:active {
    transform: none;
  }
}

