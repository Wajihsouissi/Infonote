VITE_SUPABASE_URL=https://odpxzyrtfqevnghevtwp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kcHh6eXJ0ZnFldm5naGV2dHdwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg2Mjc3ODcsImV4cCI6MjA5NDIwMzc4N30.klHiEkfQBHwlOOXV-Kb_k_F9vUs4JVXDALYazpqOxvw

# OAuth + email redirect target. Set in production hosting (Vercel, etc.) so
# Google sign-in and OTP/password-reset emails always come back to your
# canonical domain instead of localhost. Leave UNSET locally so the dev
# server falls back to window.location.origin.
VITE_SITE_URL=https://chnkit.com

# Workspace collaboration invitation emails.
# RESEND_API_KEY must be set as a server-side Vercel environment variable.
# INVITE_FROM_EMAIL must be a verified sender/domain in Resend. In Vercel's
# dashboard enter it without wrapping quotes, for example:
# Infonote <invite@chnkit.com>
# INVITE_SITE_URL controls the accept-link domain sent in invitation emails.
# SUPABASE_SERVICE_ROLE_KEY is optional and server-only. If present, invitation
# email delivery falls back to Supabase Auth when Resend rejects/sends fail.
# Never expose SUPABASE_SERVICE_ROLE_KEY with a VITE_ prefix.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INVITE_FROM_EMAIL="Infonote <invite@chnkit.com>"
INVITE_SITE_URL=https://chnkit.com
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Server-side Supabase values used by API routes. The anon/publishable key is
# enough because API routes forward the user's Bearer token and Supabase RLS
# still enforces owner/member permissions.
SUPABASE_URL=https://odpxzyrtfqevnghevtwp.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# REQUIRED for AI features (text/image/stream generation). Without a key, every
# AI request returns HTTP 500 "AI is not configured".
#
# The routes speak plain OpenAI /chat/completions, so any compatible endpoint
# works. Default is Google Gemini — get a key from https://aistudio.google.com.
# Set AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1 (with a Vercel AI
# Gateway key and openai/* model ids) to switch back to Vercel.
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_API_KEY=your_openrouter_api_key
# Optional model overrides. Defaults: openrouter/auto text,
# google/gemini-3.1-flash-image image. AI_GATEWAY_TEXT_MODEL is what "Auto" resolves
# to; AI_GATEWAY_TEXT_MODELS is the comma-separated allow-list of ids a client
# may pick in the AI panel's model menu (keep it in step with
# src/config/aiModels.ts, which is only the menu the UI draws).
# AI_GATEWAY_TEXT_MODEL=openrouter/auto
# AI_GATEWAY_TEXT_MODELS=openrouter/auto,z-ai/glm-5.3,qwen/qwen3.8-27b,google/gemini-3.7-flash,deepseek/deepseek-v4-pro-0813,x-ai/grok-4.6,anthropic/claude-opus-5,anthropic/claude-sonnet-5,google/gemini-3.6-flash,google/gemini-3.5-flash-lite,openrouter/fusion,moonshotai/kimi-k3,z-ai/glm-5.2:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free
# AI_GATEWAY_IMAGE_MODEL=bytedance-seed/seedream-5-0-pro

# Web search (the AI panel's globe toggle) uses Gemini's native `google_search`
# grounding on the SAME AI_GATEWAY_API_KEY above — there is no separate search
# key. It does, however, REQUIRE BILLING on the Google AI Studio account:
# grounded requests return 429 RESOURCE_EXHAUSTED on the free tier even while
# ordinary AI requests on that key succeed. Enable billing at
# https://aistudio.google.com, then the toggle works with no code change.
#
# Grounding answers in prose with citations; it cannot search for images or
# video. Optional override for which model grounds (defaults to the text model):
# AI_GROUNDING_MODEL=gemini-3.7-flash
