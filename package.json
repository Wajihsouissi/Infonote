{
  "name": "chnk it",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:invite-env": "node scripts/check-invite-env.mjs",
    "stress:canvas": "node scripts/canvas-stress-test.mjs",
    "check:markdown": "node --experimental-strip-types scripts/check-markdown-shortcuts.mts",
    "check:dates": "node --experimental-strip-types scripts/check-card-dates.mts",
    "check:tasks": "node --experimental-strip-types scripts/check-card-tasks.mts",
    "check:youtube-study": "node --experimental-strip-types scripts/check-youtube-study.mts",
    "check:ai-parts": "node scripts/run-bundled-check.mjs scripts/check-ai-part-rewrite.mts",
    "check:tables": "node scripts/run-bundled-check.mjs scripts/check-markdown-tables.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:core": "playwright test --project=core",
    "test:e2e:advanced": "playwright test --project=advanced",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:legacy": "playwright test --config=playwright.legacy.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
