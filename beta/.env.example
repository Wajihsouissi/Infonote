# Beta environment.
#
# In development these may also come from the repo root's .env / .env.local —
# vite.config.ts reads the parent folder first, so the full app's key works here
# without being copied. In production they are the beta Vercel project's own
# environment variables.
#
# None of these reach the browser. Only the Node side (api/ai/*, and the dev
# plugin in vite.config.ts) reads them; Vite exposes only VITE_-prefixed values
# to client code.

# --- AI provider (required for the AI panel) --------------------------------
# Google's OpenAI-compatible endpoint is the default; AI_GATEWAY_BASE_URL only
# needs setting to point somewhere else.
GEMINI_API_KEY=
# AI_GATEWAY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_TEXT_MODEL=gemini-3.7-flash
# AI_GATEWAY_TEXT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# AI_GATEWAY_FALLBACK_MODELS=

# --- Sessions (Step 6; the AI routes require one in production) -------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Local development only -------------------------------------------------
# Lets /api/ai/* answer without a signed-in session for local AI testing.
# The dev server alone honours it —
# api/_lib/aiGuard.js, which protects the deployed endpoint, never reads it.
VITE_AI_ALLOW_ANONYMOUS=true
