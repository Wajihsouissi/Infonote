{
  "name": "chnk-it-beta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "check": "npm run lint && npm run check:editor && npm run check:inline && npm run check:reading && npm run check:autosave && npm run check:transactions && npm run check:startup && npm run check:metadata && npm run check:folder && npm run build && npm run knip",
    "preview": "vite preview",
    "measure": "node scripts/measure-canvas-load.mjs",
    "measure:editor:production": "node scripts/measure-production-editor.mjs",
    "check:editor": "node scripts/check-editor-core.mjs && npm run check:reorder && npm run check:block-transfer && npm run check:editor-lifecycle",
    "check:block-transfer": "node scripts/check-block-transfer.mjs",
    "check:editor-lifecycle": "node scripts/check-editor-lifecycle.mjs",
    "check:reorder": "node scripts/check-block-reorder.mjs",
    "check:inline": "node scripts/check-inline-safety.mjs",
    "check:transactions": "node scripts/check-local-transactions.mjs",
    "check:reading": "node scripts/check-reading-work.mjs",
    "check:autosave": "node scripts/check-local-autosave.mjs",
    "check:startup": "node scripts/check-workspace-startup.mjs",
    "check:metadata": "node scripts/check-metadata-cache.mjs",
    "check:folder": "node scripts/check-folder-storage.mjs",
    "check:diagnostics": "node scripts/diagnostics/run-jira-unit.mjs",
    "build:editor-benchmark": "node scripts/build-editor-benchmark.mjs",
    "preview:editor-benchmark": "vite preview --host localhost --port 5176 --strictPort --outDir node_modules/.cache/editor-benchmark",
    "test:e2e": "playwright test --project=smoke --project=core",
    "test:e2e:browsers": "playwright test --project=firefox --project=webkit --project=edge --project=small-screen",
    "test:diagnostics:ai": "playwright test --config=e2e/config/ai-audit.config.ts",
    "test:diagnostics:cases": "playwright test --config=e2e/config/jira-case-studies.config.ts",
    "test:diagnostics:coverage": "playwright test --config=e2e/config/jira-coverage.config.ts",
    "test:diagnostics:full": "playwright test --config=e2e/config/jira-full-audit.config.ts",
    "test:heavy:headed": "node scripts/run-heavy-study.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@supabase/auth-js": "^2.116.0",
    "@xyflow/react": "^12.10.1",
    "chart.js": "4.5.1",
    "clsx": "^2.1.1",
    "d3": "7.9.0",
    "gsap": "3.15.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "thinking-orbs": "^0.3.1",
    "three": "0.186.1",
    "uuid": "^13.0.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^5.64.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.3"
  }
}
